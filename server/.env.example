# Postgres connection string. Never commit the real value.
DATABASE_URL=postgres://eva_app:changeme@127.0.0.1:5432/eva_tracker

# Secret used to sign/verify JWT access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changeme

# Access token lifetime, e.g. "15m", "1h"
JWT_ACCESS_TTL=15m

# Refresh token lifetime in days
JWT_REFRESH_TTL_DAYS=30

# Port the Node process listens on. Nginx reverse-proxies to this from 443.
PORT=3000

NODE_ENV=production
